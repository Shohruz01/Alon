app.post("/api/request-booking",(req,res)=>{

 if(!req.session.user){
  return res.json({
   success:false,
   message:"Аввал ба аккаунт ворид шавед"
  });
 }

 const { adId, date, start, end } = req.body;

 const ads = readAds();
 const ad = ads.find(a=>a.id==adId);

 if(!ad){
  return res.json({success:false,message:"Эълон ёфт нашуд"});
 }

 let list = JSON.parse(fs.readFileSync("bookings.json"));

 // check busy time
 const busy = list.find(b=>
  b.adId==adId &&
  b.date==date &&
  b.status==="confirmed" &&
  start < b.end &&
  end > b.start
 );

 if(busy){
  return res.json({
   success:false,
   message:"Ин вақт аллакай банд аст"
  });
 }

 const promo = "PB-" + Math.random().toString(36).substring(2,8).toUpperCase();

 const expireAt = Date.now() + 30 * 60 * 1000;

 const booking = {
  id: Date.now(),
  userId: req.session.user.id,
  adId,
  ownerId: ad.userId,
  date,
  start,
  end,
  promo,
  status:"pending",
  created: Date.now(),
  expireAt
 };

 list.push(booking);

 fs.writeFileSync("bookings.json",JSON.stringify(list,null,2));

 // ✅ IMPORTANT RESPONSE
 res.json({
  success:true,
  promo,
  expireAt
 });

});

function minutesToTime(min){
 let h = Math.floor(min/60);
 let m = min%60;
 return String(h).padStart(2,"0")+":"+String(m).padStart(2,"0");
}

setInterval(()=>{

 let list = JSON.parse(fs.readFileSync("bookings.json"));
 const now = Date.now();

 list = list.map(b=>{

  // pending expire
  if(
 b.status==="pending" &&
 b.expireAt &&
 now > b.expireAt
){
 b.status="expired";
}

  // confirmed finish by time
  if(b.status==="confirmed"){
   const endTime = new Date(b.date+" "+b.end).getTime();
   if(now > endTime){
    b.finished = true;
   }
  }

  return b;
 });

 fs.writeFileSync("bookings.json",JSON.stringify(list,null,2));

},60000);


app.get("/api/my-booking-requests", auth, (req,res)=>{

 const bookings = JSON.parse(fs.readFileSync("bookings.json"));
 const ads = readAds();

 // only my ads
 const myAdIds = ads
  .filter(a=>a.userId === req.session.user.id)
  .map(a=>a.id);

 const result = bookings.filter(b=>
  myAdIds.includes(Number(b.adId)) &&
  b.status === "pending"
 );

 res.json(result);

});

app.get("/api/my-active-bookings", auth, (req,res)=>{

 const bookings = JSON.parse(fs.readFileSync("bookings.json"));
 const users = readUsers();
 const ads = readAds();

 const myAdIds = ads
  .filter(a => a.userId === req.session.user.id)
  .map(a => a.id);

 const now = Date.now();

 let result = bookings.filter(b =>
  myAdIds.includes(Number(b.adId)) &&
  b.status === "confirmed" &&
  !b.finished
 );

 // ADD USERNAME
 result = result.map(b => {

  const u = users.find(x => x.id === b.userId);

  return {
   ...b,
   username: u ? (u.username || u.name) : "User"
  };

 });

 // SORT BY DATE + TIME
 result.sort((a,b)=>{

  const ta = new Date(a.date+" "+a.start).getTime();
  const tb = new Date(b.date+" "+b.start).getTime();

  return ta - tb;
 });

 res.json(result);

});

app.get("/api/my-booking-history", auth, (req,res)=>{

 const bookings = JSON.parse(fs.readFileSync("bookings.json"));
 const ads = readAds();

 const myAdIds = ads
  .filter(a=>a.userId === req.session.user.id)
  .map(a=>a.id);

 const result = bookings.filter(b=>
  myAdIds.includes(Number(b.adId)) &&
  b.status === "confirmed" &&
  b.finished === true
 );

 res.json(result);

});

app.get("/booking-action",(req,res)=>{

 const { id, action } = req.query;

 let list = JSON.parse(fs.readFileSync("bookings.json"));

 const booking = list.find(b=>b.id == id);

 if(!booking){
  return res.send("Booking not found");
 }

 if(action === "accept"){
  booking.status = "confirmed";
 }

 if(action === "reject"){
  booking.status = "rejected";
 }

 fs.writeFileSync("bookings.json",JSON.stringify(list,null,2));

 res.send(`
  <h2>✅ Амалиёт анҷом ёфт</h2>
  <p>Шартнома ${action==="accept"?"қабул":"рад"} карда шуд</p>
 `);

});

app.get("/api/my-bookings",auth,(req,res)=>{

 let list = JSON.parse(fs.readFileSync("bookings.json"));

 const my = list.filter(b=>
  b.userId === req.session.user.id
 );

 res.json(my);

});

app.post("/api/check-promo", (req,res)=>{

 let { code } = req.body;

code = code.trim().toUpperCase();

 let bookings = JSON.parse(fs.readFileSync("bookings.json"));
 let users = readUsers();

 const b = bookings.find(x => x.promo === code);

 if(!b){
  return res.json({success:false,message:"Промокод ёфт нашуд"});
 }

 // FIND REAL USER
 const u = users.find(x => x.id === b.userId);

 res.json({
  success:true,
  booking:{
   id: b.id,
   user: u ? (u.username || u.name) : "User",
   date: b.date,
   start: b.start,
   end: b.end
  }
 });

});

app.post("/api/confirm-booking",(req,res)=>{

 const { promo } = req.body;

 if(!req.session.user){
  return res.json({success:false,message:"Login required"});
 }

 let list = JSON.parse(fs.readFileSync("bookings.json"));

 const booking = list.find(b=>b.promo===promo);

 if(!booking)
  return res.json({success:false,message:"Код нодуруст"});

 // owner only
 if(booking.ownerId !== req.session.user.id){
  return res.json({
   success:false,
   message:"⛔ Ин брон ба шумо тааллуқ надорад"
  });
 }

 // expired?
 if(booking.status !== "pending"){
  return res.json({
   success:false,
   message:"Ин код фаъол нест"
  });
 }

 booking.status="confirmed";

 fs.writeFileSync("bookings.json",JSON.stringify(list,null,2));

 res.json({success:true});
});

app.get("/api/my-confirmed-bookings", auth, (req,res)=>{

 const list = JSON.parse(fs.readFileSync("bookings.json"));

 const now = Date.now();

 const result = list.filter(b=>
  b.userId === req.session.user.id &&
  b.status === "confirmed"
 );

 res.json(result);

});



